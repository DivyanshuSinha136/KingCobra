; avx_dot.kasm -- AVX2 + FMA dot product of two float arrays (SysV: rdi = a, rsi = b, edx = count (multiple of 8))
; returns the sum in xmm0 -- used by examples/kasm_rhex.kc
bits 64
global dot8
dot8:
    vxorps      ymm0, ymm0, ymm0
    xor         ecx, ecx
.loop:
    vmovups     ymm1, [rdi + rcx*4]
    vfmadd231ps ymm0, ymm1, [rsi + rcx*4]
    add         ecx, 8
    cmp         ecx, edx
    jb          .loop
    vextractf128 xmm1, ymm0, 1
    vaddps      xmm0, xmm0, xmm1
    vhaddps     xmm0, xmm0, xmm0
    vhaddps     xmm0, xmm0, xmm0
    vzeroupper
    ret

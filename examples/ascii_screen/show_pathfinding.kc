// std.ascii_screen showcase 9/10 — generated dungeon, A* path-finding, line of sight and field of view.
// space = new random target   r = new dungeon   f = toggle field of view   q = quit
import std.ascii_screen;

fn pick_floor(m: int) -> array {
    var tries = 0;
    while (tries < 500) {
        let x = ascii_screen.rand_int(1, 42);
        let y = ascii_screen.rand_int(1, 20);
        if (!ascii_screen.tile_solid(m, x, y)) { return [x, y]; }
        tries += 1;
    }
    return ascii_screen.map_spawn(m);
}

fn main() {
    ascii_screen.open("title", "ascii_screen showcase: path-finding", "fps", 30);
    var seed = 11;
    var m = ascii_screen.map_new(44, 22, "#");
    ascii_screen.map_generate(m, "dungeon", seed);
    ascii_screen.map_use(m);
    ascii_screen.viewport(0, 1, 44, 22);      // the camera looks at the CENTRE of the viewport
    ascii_screen.camera(22.0, 11.0);
    var src = ascii_screen.map_spawn(m);
    var dst = pick_floor(m);
    var path = ascii_screen.path(m, src[0], src[1], dst[0], dst[1]);
    let walker = ascii_screen.spawn(src[0] + 0.5, src[1] + 0.5, "glyph", "@", "fg", "#ffd166", "z", 5, "physics", false);
    var step = 0;
    var timer = 0.0;
    var use_fov = false;
    while (ascii_screen.poll()) {
        if (ascii_screen.key_pressed("q") || ascii_screen.key_pressed("escape")) { ascii_screen.quit(); }
        if (ascii_screen.key_pressed("f")) { use_fov = !use_fov; }
        if (ascii_screen.key_pressed("r")) {
            seed += 1;
            ascii_screen.map_fill(m, 0, 0, 44, 22, "#");
            ascii_screen.map_generate(m, "dungeon", seed);
            src = ascii_screen.map_spawn(m); dst = pick_floor(m);
            path = ascii_screen.path(m, src[0], src[1], dst[0], dst[1]); step = 0;
        }
        if (ascii_screen.key_pressed("space")) {
            src = [ascii_screen.floor(ascii_screen.get(walker, "x")), ascii_screen.floor(ascii_screen.get(walker, "y"))];
            dst = pick_floor(m);
            path = ascii_screen.path(m, src[0], src[1], dst[0], dst[1]); step = 0;
        }
        timer += ascii_screen.dt();
        if (timer > 0.06 && path != null && step < path.len) {
            ascii_screen.set(walker, "x", path[step][0] + 0.5); ascii_screen.set(walker, "y", path[step][1] + 0.5);
            step += 1; timer = 0.0;
        }
        if (use_fov) { ascii_screen.fov(m, ascii_screen.floor(ascii_screen.get(walker, "x")), ascii_screen.floor(ascii_screen.get(walker, "y")), 9); }
        ascii_screen.begin();
        ascii_screen.draw_world("fov", use_fov);
        var i = step;
        while (path != null && i < path.len) {
            let s = ascii_screen.world_to_screen(path[i][0], path[i][1]);
            ascii_screen.put(s[0], s[1], "•", "fg", "#4cc9f0");
            i += 1;
        }
        let ts = ascii_screen.world_to_screen(dst[0], dst[1]);
        ascii_screen.put(ts[0], ts[1], "X", "fg", "#ef476f", "bold", true);
        var n = 0;
        if (path != null) { n = path.len; }
        ascii_screen.text(47, 1, "A* path length: " + str(n), "fg", "white");
        ascii_screen.text(47, 3, "space  new target", "fg", "gray");
        ascii_screen.text(47, 4, "r      new dungeon", "fg", "gray");
        ascii_screen.text(47, 5, "f      field of view", "fg", "gray");
        ascii_screen.text(47, 6, "q      quit", "fg", "gray");
        ascii_screen.present();
    }
    ascii_screen.close();
}

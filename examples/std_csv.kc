import std.csv;
import std.json;

fn is_red(r) -> bool { return r["team"] == "red"; }

fn main() {
    let text = "name,score,team,note\nAda,90,red,\"likes \"\"quotes\"\"\"\nBob,75.5,blue,\"two\nlines\"\nCy,,red,\nDee,100,blue,plain\n";

    // ---- arrays of strings by default; "header infer" gives typed records ----
    let rows = csv.parse(text);
    print("rows:", len(rows), "first:", rows[0], "quoted:", rows[1][3]);
    let recs = csv.parse(text, "header infer");
    print("records:", len(recs), json.stringify(recs[0]));
    print("typed:", json.type_of(recs[0]["score"]), json.type_of(recs[1]["score"]), json.type_of(recs[2]["score"]));

    // ---- table helpers ----
    print("sorted:", csv.column(csv.sort_by(recs, "score", "desc"), "name"));
    print("stats:", csv.stats(recs, "score"));
    print("red team:", len(csv.filter(recs, is_red)));
    print("select:", json.stringify(csv.select(recs, ["team", "name"])));

    // ---- writing: correct quoting, other dialects ----
    print(csv.stringify([["id", "note"], [1, "has \"quotes\""], [2, "a,b"], [3, null]]));
    print(csv.stringify(recs, "delim=; always_quote"));
    print("sniff:", csv.sniff("x|y|z\n1|2|3\n"), "auto:", csv.parse("a;b\n1;2", "delim=auto"));

    // ---- streaming reader / writer ----
    let w = csv.writer("/tmp/kingcobra_csv_demo.csv");
    csv.write_rows(w, recs);
    csv.close(w);
    let r = csv.open("/tmp/kingcobra_csv_demo.csv", "header infer");
    print("header:", csv.header(r));
    var total = 0;
    var row = csv.read(r);
    while (row != null) {
        if (row["score"] != null) { total = total + row["score"]; }
        row = csv.read(r);
    }
    csv.close(r);
    print("total score:", total, "| data rows:", csv.count_rows("/tmp/kingcobra_csv_demo.csv", "header"));

    // ---- robustness ----
    print("bad input:", csv.try_parse("a,\"never closed\n", "BAD"));
    print("ragged, lenient:", csv.parse("a,b\n1,2,3\n4", "header"));
}

mark intro 0:00                  # named timestamps (see music_note.markers)
mark drop  0:09.2308             # = bar 5 at 104 BPM (16 beats)

track drums drums vol=0.9
$four_floor $four_floor          /* two bars of kick ... */
at=drop                          # jump to an absolute time
|: $four_floor :|x4

track snare drums vol=0.7 reverb=0.2
at=drop $backbeat*4

track hats drums vol=0.45 pan=0.2
at=drop $hats8*4

track bass bass vol=0.8
at=drop $bassline*4

track pluck_line sample=pluck pan=-0.25 reverb=0.25
A3:q C4:q E4:q \
A4:h                             # a backslash continues the line
at=drop
[A3 C4 E4]:h~ [A3 C4 E4]:q  r:q
E4:e G4:e A4:q E4:q r:q

track bells                      # one-shot inline sample, placed by timestamp
at=0:02.5 &chime
at=0:05 &chime
at=drop &chime
at=0:16 &chime:q

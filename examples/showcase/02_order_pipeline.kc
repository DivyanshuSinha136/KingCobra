// SHOWCASE 2 — E-commerce order pipeline (CSV in, validated invoices out)
//
// The classic "messy data in, trustworthy data out" job: read a CSV export, validate every
// row against a JSON Schema, price the good rows (tax by country, coupons, free shipping),
// quarantine the bad rows WITH reasons, and publish JSON + CSV outputs. Money is kept in
// integer cents, so there is no floating-point drift anywhere.
//
// Uses: std.csv (header/infer/trim), std.json (schema validation, files), std.system,
//       structs, impl, enums, match, try/catch/throw, closures, destructuring.
//
// Run:  kingcobra examples/showcase/02_order_pipeline.kc
import std.csv;
import std.json;
import std.system;

let EXPORT = "order_id,customer,sku,qty,unit_price,country,coupon
1001, Ada Lovelace ,KEY-001,2,49.99,US,
1002,Grace Hopper,MON-204,1,329.00,DE,SAVE10
1003,Linus T,CAB-017,10,4.50,US,VIP20
1004,Margaret H,KEY-001,0,49.99,US,
1005,Dennis R,usb-9,3,12.00,JP,
1006,Ken T,MON-204,1,329.00,FR,
1007,Barbara L,CAB-017,2,4.50,IN,FREESHIP
1008,,KEY-001,1,49.99,US,
1009,Alan T,KEY-001,1,-5.00,US,
1010,Edsger D,MON-204,2,329.00,DE,HALFOFF
1011,Tim B-L,KEY-001,1,49.99,JP,VIP20
1012,Ada Lovelace,CAB-017,7,4.50,IN,
";

const SCHEMA = "{\"type\":\"object\",\"required\":[\"order_id\",\"customer\",\"sku\",\"qty\",\"unit_price\",\"country\"],\"properties\":{\"order_id\":{\"type\":\"integer\"},\"customer\":{\"type\":\"string\",\"minLength\":2},\"sku\":{\"type\":\"string\",\"pattern\":\"^[A-Z]{3}-[0-9]{3}$\"},\"qty\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":1000},\"unit_price\":{\"type\":\"number\",\"exclusiveMinimum\":0},\"country\":{\"enum\":[\"US\",\"DE\",\"IN\",\"JP\"]}}}";

struct Invoice { order_id: int, customer: string, country: string, subtotal: int, discount: int, shipping: int, tax: int, total: int }

impl Invoice {
    fn check(self) -> bool { return self.total == self.subtotal - self.discount + self.shipping + self.tax; }
}

fn money(cents: int) -> string {
    let sign = cents < 0 ? "-" : "";
    let c = abs(cents);
    return f"{sign}{idiv(c, 100)}.{str(c % 100).pad_left(2, "0")}";
}

fn tax_rate(country: string) -> int {            // percent
    return match (country) { "US" => 8, "DE" => 19, "IN" => 18, "JP" => 10, _ => 0 };
}

fn price(rec) -> Invoice {
    let subtotal = rec["qty"] * int(rec["unit_price"] * 100 + 0.5);
    var discount = 0;
    var shipping = subtotal >= 5000 ? 0 : 500;
    let coupon = rec["coupon"];
    if (coupon != null) {
        if (coupon == "SAVE10") {
            discount = idiv(subtotal, 10);
        } else if (coupon == "FREESHIP") {
            shipping = 0;
        } else if (coupon == "VIP20") {
            if (rec["qty"] < 3) { throw error(f"coupon VIP20 needs at least 3 items (got {rec["qty"]})"); }
            discount = idiv(subtotal, 5);
        } else {
            throw error(f"unknown coupon '{coupon}'");
        }
    }
    let taxable = subtotal - discount;
    let tax = idiv(taxable * tax_rate(rec["country"]) + 50, 100);
    return Invoice {
        order_id: rec["order_id"], customer: rec["customer"], country: rec["country"],
        subtotal: subtotal, discount: discount, shipping: shipping, tax: tax,
        total: taxable + shipping + tax
    };
}

fn main() {
    let records = csv.parse(EXPORT, "header infer trim");
    print(f"read {len(records)} rows");

    var good = [];
    var quarantine = [];
    for (rec in records) {
        // stage 1: structural validation against the schema
        let problems = json.validate(rec, SCHEMA);
        if (len(problems) > 0) {
            quarantine.push({ order: rec["order_id"], reasons: problems });
            continue;
        }
        // stage 2: business rules (which can throw)
        try {
            let inv = price(rec);
            assert(inv.check(), "invoice arithmetic must balance");
            good.push(inv);
        } catch (e) {
            quarantine.push({ order: rec["order_id"], reasons: [e.message] });
        }
    }

    print(f"\n=== {len(good)} invoices ===");
    print("  order  customer          cc  subtotal  discount  shipping       tax     total");
    for (i in good) {
        print(f"  {i.order_id}  {i.customer.pad_right(16)}  {i.country}  {money(i.subtotal).pad_left(8)}  {money(-i.discount).pad_left(8)}  {money(i.shipping).pad_left(8)}  {money(i.tax).pad_left(8)}  {money(i.total).pad_left(8)}");
    }

    print(f"\n=== {len(quarantine)} orders quarantined ===");
    for (q in quarantine) {
        for (reason in q.reasons) { print(f"  order {q.order}: {reason}"); }
    }

    // revenue by country
    let by_country = {};
    for (i in good) {
        let row = by_country[i.country] ?? { country: i.country, orders: 0, revenue: 0 };
        row["orders"] += 1;
        row["revenue"] += i.total;
        by_country[i.country] = row;
    }
    let summary = values(by_country);
    summary.sort(fn(a, b) -> int { return b["revenue"] - a["revenue"]; });
    print("\n=== revenue by country ===");
    for (row in summary) { print(f"  {row["country"]}  {row["orders"]} orders  {money(row["revenue"]).pad_left(9)}"); }

    // publish
    let dir = system.make_temp_dir("kc_orders_");
    defer system.rmdir(dir, true);
    json.write_file(system.path_join(dir, "invoices.json"), good);
    csv.write_file(system.path_join(dir, "by_country.csv"), summary);
    json.write_file(system.path_join(dir, "quarantine.json"), quarantine);

    let back = json.parse_file(system.path_join(dir, "invoices.json"));
    var grand = 0;
    for (b in back) { grand += b["total"]; }
    print(f"\npublished invoices.json / by_country.csv / quarantine.json -> grand total {money(grand)}");

    // invariants the whole pipeline must satisfy
    assert_eq(len(good) + len(quarantine), len(records));
    var from_summary = 0;
    for (row in csv.parse_file(system.path_join(dir, "by_country.csv"), "header infer")) { from_summary += row["revenue"]; }
    assert_eq(from_summary, grand);
    print("all invariants hold: every row accounted for, CSV and JSON totals agree");
}

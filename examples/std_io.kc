import std.io;

fn main() {
    let path = "/tmp/kingcobra_io_test.txt";

    io.write_file(path, "line one\nline two\nline three");
    print("exists after write:", io.exists(path));

    let content = io.read_file(path);
    print("read back:", content);

    io.append_file(path, "\nline four");
    let lines = io.lines(path);
    print("line count:", len(lines));
    for (l in lines) {
        print(" -", l);
    }

    io.delete(path);
    print("exists after delete:", io.exists(path));
}

// KingCobra v0.2 — struct instances: declare a type, construct it with
// a literal, read and mutate fields. Structs are reference types, like
// arrays: copies of a struct value share the same underlying fields.

struct Point {
    x: int,
    y: int,
}

fn dist_sq(p: Point) -> int {
    return p.x * p.x + p.y * p.y;
}

fn translate(p: Point, dx: int, dy: int) {
    p.x += dx;
    p.y += dy;
}

fn main() {
    let a = Point { x: 3, y: 4 };
    print("a =", a);
    print("dist_sq(a) =", dist_sq(a));

    translate(a, 1, 1); // structs are references, so this mutates `a`
    print("after translate, a =", a);

    let b = a; // same reference
    b.x = 100;
    print("a.x after mutating through b:", a.x);
}

// KingCobra — core language features: let/var, if/else, while, for,
// functions, closures, arrays, recursion.

fn fib(n: int) -> int {
    if (n < 2) { return n; }
    return fib(n - 1) + fib(n - 2);
}

fn make_adder(x: int) -> fn {
    fn adder(y: int) -> int {
        return x + y;
    }
    return adder;
}

fn main() {
    var total: int = 0;
    for (i in 0..10) {
        total += i;
    }
    print("sum 0..10 =", total);

    let nums = [1, 2, 3, 4, 5];
    var squares = [];
    for (n in nums) {
        push(squares, n * n);
    }
    print("squares =", squares);

    print("fib(12) =", fib(12));

    let add5 = make_adder(5);
    print("add5(10) =", add5(10));

    var i: int = 0;
    while (i < 3) {
        print("while i =", i);
        i += 1;
    }

    if (total > 40 && len(nums) == 5) {
        print("condition ok");
    } else {
        print("condition failed");
    }
}

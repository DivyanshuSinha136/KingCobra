enum Color { Red, Green = 5, Blue }
fn classify(x: int) -> int {
    switch (x) {
        case 1: return 100;
        case 2, 3: x = x * 10;
        case 4: x = x + 1; break;
        default: x = -1;
    }
    return x;
}
fn name(c: int) -> int {
    return match (c) { Color.Red => 10, Color.Green | 7 => 20, Color.Blue => 30, _ => 0 };
}
fn main() -> int {
    for (var v = 0; v < 6; v++) { println("classify", v, classify(v)); }
    println(name(0), name(5), name(6), name(7), name(9));
    var t = 0;
    outer: for (i in 0..5) {
        for (j in 0..5) {
            if (j == 3) { continue outer; }
            if (i == 3) { break outer; }
            t += i * 10 + j;
        }
    }
    println("t", t);
    var k = 0;
    again:
    k++;
    if (k < 4) { goto again; }
    println("k", k);
    var d = 0;
    do { d += 2; } while (d < 9);
    println("d", d);
    let arr: int[4] = [3, 1, 4, 1];
    var sum = 0;
    for (x in arr) { sum += x; }
    for (idx, x in arr) { sum += idx * x; }
    println("sum", sum);
    match (sum) { 0 => println("zero"), _ => println("nonzero") }
    return 0;
}

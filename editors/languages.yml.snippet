# Add this entry to lib/linguist/languages.yml in a fork of github-linguist/linguist
# (keep the file alphabetically sorted; "KingCobra" goes between "Kaitai Struct" and "Kit").
# Run `script/update-ids` or `bundle exec rake samples` as described in CONTRIBUTING.md to fill in language_id.
KingCobra:
  type: programming
  color: "#d4a017"
  extensions:
  - ".kc"
  tm_scope: source.kingcobra
  ace_mode: text
  codemirror_mode: clike
  codemirror_mime_type: text/x-csrc
  language_id: 0   # replaced by script/update-ids with a generated random id
